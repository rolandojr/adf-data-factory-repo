											"name": "Fecha",
											"type": "Datetime",
											"value": {
												"value": "@formatDateTime(utcNow(),'yyyy-MM-dd HH:mm:ss.fff')",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "Tabla",
											"type": "String",
											"value": "Ventas",
											"direction": "Input"
										}
									],
									"type": "Query",
									"text": {
										"value": "UPDATE ControlTablas\nSET UltimaFechaCarga = @Fecha\nWHERE NombreTabla = @Tabla;",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-29T16:08:38Z"
			},
			"dependsOn": []
		},
